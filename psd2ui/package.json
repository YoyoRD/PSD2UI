{
  "name": "@yoyoengine/psd2ui",
  "version": "0.1.0",
  "private": true,
  "description": "PSD2UGUI Photoshop 插件、公共 Core/Schema 与可选 PS-MCP；不分发 Unity Adapters。",
  "type": "commonjs",
  "scripts": {
    "test": "node --test Tests/Core/*.test.js Tests/UXP/*.test.js Tests/CEP/*.test.js PS-MCP/tests/*.test.js",
    "build:cep": "node scripts/build-cep.js",
    "package:cep": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/package-cep.ps1",
    "check:cep": "node scripts/build-cep.js --check",
    "sync": "node scripts/sync-generated.mjs",
    "check:generated": "node scripts/sync-generated.mjs --check"
  },
  "dependencies": {
    "pngjs": "4.0.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "acorn": "8.15.0"
  }
}
